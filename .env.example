# Copy to .env and edit. All values are optional for local development.
# A long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Leave unset to use a local SQLite file (instance/studentspend.db).
# For production use PostgreSQL, e.g. postgresql://user:pass@host:5432/studentspend
# DATABASE_URL=
# Set to 1 when the site is served over HTTPS (production)
SESSION_COOKIE_SECURE=0
PORT=5000
